
--[[
    BOWKAO ACTION MIRROR V1
    LocalScript
    For your own Roblox experience

    Mirrors:
    - Movement direction
    - Jump state

    Does not automatically copy combat inputs,
    tool activations, or game-specific abilities.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer

-- CONFIGURATION
local CONFIG = {
    TargetUsername = "PlayerNameHere",
    Delay = 0.01,
}

local running = true
local elapsed = 0
local targetJumping = false
local wasJumping = false

local function getCharacterData(player)
    if not player or not player.Character then
        return nil
    end

    local character = player.Character
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not root or humanoid.Health <= 0 then
        return nil
    end

    return {
        Character = character,
        Humanoid = humanoid,
        Root = root,
    }
end

local function findTarget()
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Name:lower() == CONFIG.TargetUsername:lower()
            and player ~= LocalPlayer then
            return player
        end
    end

    return nil
end

local target = findTarget()
local pendingDirection = Vector3.zero
local pendingJump = false

local connection

connection = RunService.Heartbeat:Connect(function(dt)
    if not running then
        return
    end

    elapsed += dt

    local myData = getCharacterData(LocalPlayer)
    target = target or findTarget()

    local targetData = getCharacterData(target)

    if not myData or not targetData then
        pendingDirection = Vector3.zero
        pendingJump = false
        wasJumping = false
        return
    end

    -- Capture the target's movement direction.
    pendingDirection = targetData.Humanoid.MoveDirection

    -- Detect a new jump.
    local state = targetData.Humanoid:GetState()
    local isJumping = state == Enum.HumanoidStateType.Jumping

    pendingJump = isJumping and not wasJumping
    wasJumping = isJumping

    if elapsed < CONFIG.Delay then
        return
    end

    elapsed = 0

    -- Apply movement to our own character.
    myData.Humanoid:Move(pendingDirection, false)

    if pendingJump and myData.Humanoid.FloorMaterial ~= Enum.Material.Air then
        myData.Humanoid.Jump = true
    end

    pendingJump = false
end)

script.Destroying:Connect(function()
    running = false

    if connection then
        connection:Disconnect()
    end
end)

print("[BOWKAO ACTION MIRROR] Initialized")
